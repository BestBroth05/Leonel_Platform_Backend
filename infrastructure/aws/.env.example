# Copy to /opt/leonel-platform/.env on the EC2 host. Never commit real values.

LEONEL_PLATFORM_ENV=production
POSTGRES_DB=leonel_platform
POSTGRES_USER=leonel_platform
POSTGRES_PASSWORD=change-me-strong-db-password

JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

CORS_ORIGIN=https://bestbroth05.github.io
ADMIN_EMAIL=admin@leonel-platform.local
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_NAME=Administrador

# Safe to leave true: seed is idempotent (creates admin only if missing).
SEED_ON_BOOT=true

# Optional local backup dir used by scripts/backup-pg.sh
BACKUP_DIR=/opt/leonel-platform/backups
# Optional S3 destination (empty = local only)
# S3_BACKUP_URI=s3://your-bucket/leonel-platform/pg
